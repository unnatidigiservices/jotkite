# JotKite
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # If clean URLs give a 404 or 500 on your host, uncomment and set this to
  # the folder JotKite lives in (with slashes), e.g. /blog/
  # RewriteBase /blog/

  # Never serve internals directly.
  RewriteRule ^(data|lib|dist)(/|$) - [F,L]
  # The repository's docs/ and tools/ files are never served either, but the
  # names stay free for your own pages, e.g. /docs/ or /tools/.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(docs|tools)/ - [F,L]
  RewriteRule ^(docs|tools)/?$ index.php?route=$1 [QSA,L]
  # Addon code and manifests are never served directly (their CSS/JS/images are).
  RewriteRule ^addons/.+\.(php|json|md)$ - [F,L]
  RewriteRule ^(config(\.sample)?\.php|[^/]+\.md|\.git.*)$ - [F,L]

  # Everything that isn't a real file or folder goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

# Browser caching: CSS/JS are versioned (?v=), so keep them a year; icons a week.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
